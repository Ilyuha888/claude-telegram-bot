# Claude Telegram Bot - Environment Configuration

# ==============================================================================
# REQUIRED
# ==============================================================================

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Telegram user ID allowed to use the bot (single integer — bot is single-tenant per deployment)
# Find your ID: message @userinfobot on Telegram
TELEGRAM_ALLOWED_USER=123456789

# ==============================================================================
# RECOMMENDED
# ==============================================================================

# Working directory where Claude runs (loads CLAUDE.md, skills, MCP config)
CLAUDE_WORKING_DIR=/path/to/your/vault

# Path to your ctb-vault clone (or personal Obsidian vault)
# Scheduler prompts read from ${CTB_VAULT_DIR}/prompts/scheduler/
# Defaults to ~/repos/ctb-vault if not set
CTB_VAULT_DIR=/path/to/your/vault

# Runtime state: schedules, notification history, chat session history, topics,
# audit log. Defaults to ~/bot-data. docker-compose mounts this path into the
# container as /data/bot-data.
# BOT_DATA_DIR=/path/to/your/bot-data

# OpenAI API key for voice message transcription
# Without this, voice messages won't work
OPENAI_API_KEY=sk-...

# ==============================================================================
# OPTIONAL - Parallel Sessions (Forum Topics)
# ==============================================================================

# Supergroup the bot opens topics in. Unset = single-DM behavior, unchanged.
# Set it and each topic becomes an independent Claude session, spawned by
# /topic or by the "Open in new chat" button on a notification.
#
# One-time manual setup, all of it required:
#   1. Create a supergroup and turn on Topics (Manage group -> Topics).
#   2. Add this bot as an admin with the "Manage Topics" permission.
#   3. Disable privacy mode for the bot in @BotFather (/setprivacy -> Disable),
#      otherwise it only sees commands and replies in the group.
#   4. Keep the group's membership to yourself — auth is still one user id.
# TELEGRAM_GROUP_CHAT_ID=-1001234567890

# Lifecycle knobs. All inert unless TELEGRAM_GROUP_CHAT_ID is set.
#
# Drop an unused conversation from memory after this many minutes. Invisible:
# the next message in that topic re-creates it and resumes the same session.
# SESSION_IDLE_EVICT_MINUTES=120
# Auto-close a topic left untouched this many days. 0 disables it.
# TOPIC_IDLE_CLOSE_DAYS=7
# Cap on open topics. Spawning past it closes the oldest idle one first, and
# fails if every topic is busy. 0 disables the cap.
# MAX_ACTIVE_TOPICS=20
# How often the two timers above are scanned.
# TOPIC_REAPER_INTERVAL_MS=300000

# How long a conversation can sit idle and still be continued automatically by
# the next message in it. Two values because the two objects differ: a DM is one
# rolling scratchpad, a topic is a named thread you opened on purpose and close
# by hand, so continuing it next week is the point.
#
# Cost of a long window: resume price scales with transcript length and the
# prompt cache expires after an hour, so the first message after a long gap
# re-reads the whole transcript at full price, and a long-lived topic eventually
# needs /compact. Ceiling: Claude Code deletes its own transcripts after
# cleanupPeriodDays (default 30), so past ~720h this only mints session ids that
# fail on use — raise that setting too if you want longer.
# AUTO_RESUME_TTL_HOURS=24
# TOPIC_AUTO_RESUME_TTL_HOURS=720

# ==============================================================================
# OPTIONAL - Security
# ==============================================================================

# Comma-separated paths Claude can access
# Default: working dir, ~/Documents, ~/Downloads, ~/Desktop, ~/.claude
# Note: Setting this OVERRIDES defaults. Include ~/.claude for plan mode to work.
# ALLOWED_PATHS=/path/to/your/vault,/path/to/your/repos,/path/to/your/bot-data,~/.claude

# Rate limiting (token bucket)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=20
# RATE_LIMIT_WINDOW=60

# ==============================================================================
# OPTIONAL - Claude Authentication
# ==============================================================================

# API key for environments without Claude Code CLI auth
# Get from: https://console.anthropic.com/
# Note: API usage is billed per token - CLI auth is more cost-effective
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Path to Claude CLI (auto-detected from PATH by default)
# CLAUDE_CLI_PATH=/usr/local/bin/claude

# ==============================================================================
# OPTIONAL - Mode 2 (remote coding sessions: /work, /sessions, /attach, /close)
# ==============================================================================
#
# Mode-2 RC hosts run under a tmux server owned by a SEPARATE systemd unit,
# claude-rc-tmux.service (see systemd/claude-rc-tmux.service). That unit is what
# lets them survive `systemctl restart claude-telegram-bot`. There is deliberately
# no env var for it: the unit either exists, or spawning refuses and logs the
# remedy. The knobs below are the ones worth tuning.

# Where repos available to /work are discovered. Defaults to ~/repos.
# REPOS_DIR=/home/you/repos

# How often the idle-session reaper scans. Default 1 hour.
# REAPER_INTERVAL_MS=3600000

# Retire a work session after this long with no /attach. Default 7 days.
# Measured from the last attach — a session rebuilt by resumeOnBoot gets its
# clock reset, so it is not reaped immediately after a long outage.
# REAPER_IDLE_THRESHOLD_MS=604800000

# Give each /menu session its own git worktree under <repo>/.worktrees/.
# Set to false to spawn in the repo root instead (flat, shared checkout).
# MODE2_MENU_WORKTREE=true

# What a fresh worktree inherits from the parent checkout. Linked entries are
# large and shared (installing inside the worktree mutates the parent's copy);
# copied entries are small and may hold secrets, and .worktrees/ is gitignored
# so they cannot be staged from the parent repo.
# WORKTREE_LINK_PATHS=node_modules,.venv,venv,vendor
# WORKTREE_COPY_PATHS=.env,.env.local,.claude/settings.local.json

# ==============================================================================
# OPTIONAL - Extended Thinking
# ==============================================================================

# Keywords that trigger extended thinking (comma-separated, case-insensitive)
# THINKING_KEYWORDS=think,pensa,ragiona

# Keywords that trigger deep thinking (50k tokens)
# THINKING_DEEP_KEYWORDS=ultrathink,think hard,pensa bene

# ==============================================================================
# OPTIONAL - Voice Transcription
# ==============================================================================

# Path to a text file with additional context for voice transcription
# (names, technical terms, etc. — keeps personal context outside this repo)
# TRANSCRIPTION_CONTEXT_FILE=/path/to/transcription-context.txt

# ==============================================================================
# OPTIONAL - Rich Messages (Bot API 10.1/10.2)
# ==============================================================================

# Master kill switch for the Rich Message path (long/structured answers arrive
# as one document instead of 4096-char chunks). Set to false to fall back to
# the plain HTML + chunking behaviour.
# RICH_MESSAGES_ENABLED=true

# Live draft streaming via sendRichMessageDraft (private chats only).
# Set to false to stream with message edits but still finalize as a Rich Message.
# RICH_STREAMING_ENABLED=true

# ==============================================================================
# OPTIONAL - Turn Batching
# ==============================================================================

# A burst of messages — forwarded, or typed faster than Claude answers —
# becomes ONE turn instead of one per message.

# Trailing debounce: each arriving message pushes the dispatch out by this much.
# Set to 0 to disable burst batching (the rollback switch — a config change, not
# a revert). Albums keep coalescing either way.
# TURN_BATCH_WINDOW_MS=1500

# Ceiling from the first buffered message, so a steady trickle can't defer the
# answer forever.
# TURN_BATCH_MAX_WAIT_MS=15000

# Flush early rather than drop. Must comfortably exceed one album (10).
# TURN_BATCH_MAX_ITEMS=25

# Prompt weight in bytes, dominated by base64 media. Default 24 MiB.
# TURN_BATCH_MAX_BYTES=25165824

# The "📥 Collecting…" card: always | multi | off
# `multi` shows it only when it carries information (2+ messages, or a turn
# already running).
# TURN_BATCH_CARD=always

# ==============================================================================
# OPTIONAL - Logging
# ==============================================================================

# Audit log path
# AUDIT_LOG_PATH=/path/to/your/bot-data/audit.log

# Output audit logs as JSON (default: human-readable)
# AUDIT_LOG_JSON=false
